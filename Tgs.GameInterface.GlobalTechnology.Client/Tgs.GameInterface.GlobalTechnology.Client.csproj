		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
	</ItemGroup>


	<ItemGroup>
		<ProjectReference Include="..\Tgs.GameInterface.GlobalTechnology.Protos\Tgs.GameInterface.GlobalTechnology.Protos.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

</Project>
